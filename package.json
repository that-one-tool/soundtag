{
  "name": "soundtag",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "soundtag": "dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=99 --test-coverage-branches=97 --test-coverage-functions=100 --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "ink": "^8.0.0",
    "node-id3": "^0.2.9",
    "node-taglib-sharp": "^6.0.3",
    "react": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "node-taglib-sharp": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
